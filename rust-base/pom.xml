    <!--
      Language-agnostic foundations: the message bundle, collection and process helpers, the
      graph types and the icon set. Nothing here knows what Rust is, so it can be depended on
      from anywhere in the plugin.
    -->

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                </configuration>
            </plugin>
            <plugin>
                <groupId>consulo.maven</groupId>
                <artifactId>maven-consulo-plugin</artifactId>
                <extensions>true</extensions>
                <executions>
                    <!--
                      A jar module does not get the consulo lifecycle, so the generator has to be
                      bound explicitly. Without this RustIconGroup is silently never produced - the
                      mojo logs and continues rather than failing the build.
                    -->
                    <execution>
                        <id>gen</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate-icon</goal>
                            <goal>generate-localize</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

