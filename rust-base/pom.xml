        <!-- JetBrains markdown library (plain Kotlin/JVM) used by RsDocPipeline to render
             doc comments to HTML. Not an IntelliJ API. Bundled kotlin-stdlib alongside
             so the lib's runtime calls resolve — kept non-transitive via runtime scope
             so downstream JPMS consumers don't inherit kotlin as `requires`. -->
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>markdown-jvm</artifactId>
            <version>0.7.2</version>
            <exclusions>
                <!-- the platform already provides fastutil 8.5.14 via consulo-application-api;
                     markdown-jvm would bundle an older fastutil-core and split the package -->
                <exclusion>
